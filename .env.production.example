# ============================================================
# IIQE App 生產環境配置模板
# 部署時複製為 .env.production 並填入真實值
#   cp .env.production.example .env.production
#   vim .env.production
# 真實的 .env.production 不會被 git 追蹤(已配置 .gitignore)
#
# 注:HTTPS 證書由 **宿主 nginx + certbot webroot** 處理,
# 不需要在本文件配置 DOMAIN / LETSENCRYPT_EMAIL
# 證書相關流程見 DEPLOY.md 第 1.4 節
# ============================================================

# ----- 必填 -----

# 站點域名(裸域,不帶 https://) — 用於部署時手動填到 nginx/iiqe.conf
DOMAIN=your-domain.example.com

# Let's Encrypt 註冊郵箱,用於證書過期提醒
# 此變量在容器內不讀取,僅作為部署時的記錄備忘
LETSENCRYPT_EMAIL=you@example.com

# ----- 數據庫 -----

# SQLite 文件路徑(容器內)。/data 已掛載到 named volume iiqe-data
# 升級與重啟時數據保留;請勿隨意刪除 iiqe-data volume
DATABASE_URL=file:/data/prod.db

# ----- 用戶權限對齊 -----

# 在 VPS 上跑 `id ecs-user`,把得到的 UID/GID 填入
# 阿里雲 Ubuntu 默認 ecs-user 通常是 1000:1000,可保持默認
UID=1000
GID=1000

# ----- 歷史占位(當前應用未使用,留作日後接入登錄系統) -----

AUTH_SECRET=please-change-me-to-a-random-32-char-string

# ----- Vercel 相關(自託管不需要,移除 .env.production 中的舊值) -----

# 如果你從 Vercel 遷移到自託管,請刪除 .env.production 中的:
#   EDGE_CONFIG
#   VERCEL_OIDC_TOKEN
# 這些 token 屬於 Vercel 平台,自託管場景下無用