# ============================================================
# IIQE App 生產環境配置模板
# 部署時複製為 .env.production 並填入真實值
#   cp .env.production.example .env.production
#   vim .env.production
# 真實的 .env.production 不會被 git 追蹤(已配置 .gitignore)
#
# 注:HTTPS 證書由 **宿主 nginx + certbot webroot** 處理,
# 不需要在本文件配置 DOMAIN / LETSENCRYPT_EMAIL
# 證書相關流程見 DEPLOY.md 第 1.4 節
# ============================================================

# ----- 必填 -----

# 站點域名(裸域,不帶 https://) — 用於部署時手動填到 nginx/iiqe.conf
DOMAIN=your-domain.example.com

# Let's Encrypt 註冊郵箱,用於證書過期提醒
# 此變量在容器內不讀取,僅作為部署時的記錄備忘
LETSENCRYPT_EMAIL=you@example.com

# ----- 數據庫 -----

# SQLite 文件路徑(容器內)。/data 已掛載到 named volume iiqe-data
# 升級與重啟時數據保留;請勿隨意刪除 iiqe-data volume
DATABASE_URL=file:/data/prod.db

# ----- 用戶權限對齊 -----

# 在 VPS 上跑 `id <your-username>`,把得到的 UID/GID 填入
# 大多數 Linux VPS 默認登入用戶 UID/GID 是 1000:1000,可保持默認
UID=1000
GID=1000

# ----- 管理員認證 -----

# 管理員會話標籤(完整值,需含 user: 前綴)
# 僅作識別/顯示用,「不再」作為權限判斷依據。
# 真實管理員身份由下方 ADMIN_TOKEN 登錄後簽發的簽名 Cookie 決定。
ADMIN_ID=

# 會話 Cookie 簽名密鑰(HMAC-SHA256)。必填,請用隨機 32 位元組 base64url。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 請由密鑰管理器 / Vercel Env 注入,勿提交到倉庫。
AUTH_SECRET=

# 管理員登錄 Token:/api/admin/login 憑此發放 admin Cookie。
# 與 ADMIN_ID 無關,請用高熵隨機值並妥善保管。
ADMIN_TOKEN=