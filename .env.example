# ============================================================
# IIQE App 本地开发环境配置模板
# 复制为 .env 并填入真实值(或留空使用默认值)
#   cp .env.example .env
# 真实的 .env 不会被 git 追踪(已配置 .gitignore)
# ============================================================

# ----- 存储后端 -----

# Vercel KV — 在 Vercel Dashboard 创建 KV Database 后填入以下三项
# 本地开发可不填,自动回退到 in-memory / SQLite
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 本地 SQLite 数据库路径(默认 ./prisma/dev.db)
DATABASE_URL=file:./prisma/dev.db

# ----- 管理员认证 -----

# 管理员会话标签(完整值,需含 user: 前缀)
# 仅作识别/显示用,「不再」作为权限判断依据。
# 真实管理员身份由下方 ADMIN_TOKEN 登录后签发的签名 Cookie 决定。
ADMIN_ID=

# 会话 Cookie 签名密钥(HMAC-SHA256)。必填,请用随机 32 字节 base64url。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# 管理员登录 Token:/api/admin/login 凭此发放 admin Cookie。
# 与 ADMIN_ID 无关,请使用高熵随机值并妥善保管,勿提交到仓库。
ADMIN_TOKEN=

# ----- 网站分析(可选;留空则不渲染任何统计脚本) -----

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.is/script.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js