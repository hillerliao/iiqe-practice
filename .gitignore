# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-err.log
dev-out.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (由 prisma generate 产生)
/lib/generated/prisma

# sqlite dev database
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.db.backup.*

# IDE / AI agent artifacts
.codebuddy

# build/deploy artifacts
/iiqe-deploy/
/deploy-stage/
*.tar
*.tar.gz
*.log
build.log
build_check.log
dev_err*.log

# agent / tool caches (never commit)
.workbuddy/
.zcode/
/.iiqe-agent-tmp/

# python cache
__pycache__/
*.pyc

# prisma db backups (contain real user data, not schema)
*.db.bak*

# local JSON backups (timestamped scratch artifacts, never commit)
*.json.bak.*

# local scratch artifacts (never commit)
/tmp-audit-render/
page_code.txt
page_local.html
rec_out.json
/-w
_p3_clean.json
cleanup-test.mjs
scripts/cache_*.json
scripts/mock_p1.json
scripts/mock_p3.json
scripts/p3_clean.json
scripts/_mock_*.txt
scripts/test_question_*.mts
!scripts/test_question_data.mts
!scripts/test_question_statements.mts
GIT_PUSH_REVIEW_*.md
.cache_paper1.json
.cache-prod-*.db-shm
.cache-prod-*.db-wal

# local deploy helper (may contain hardcoded IP)
deploy-with-ip.ps1
